{
    "name": "sellmate/laravel-multi-tenant",
    "version": "13.0.7",
    "license": "MIT",
    "description": "Multi tenant package for Laravel Framework",
    "authors": [
        {
            "name": "Eunjun Park",
            "email": "ej@sellmate.co.kr"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/passport": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Sellmate\\Laravel\\MultiTenant\\Tests\\": "tests/"
        },
        "classmap": [
            "database/Tenant.php"
        ]
    },
    "autoload": {
        "psr-4": {
            "Sellmate\\Laravel\\MultiTenant\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sellmate\\Laravel\\MultiTenant\\Providers\\MultiTenantServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}